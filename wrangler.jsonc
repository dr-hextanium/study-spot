// Cloudflare Workers Builds deploys the PWA as static assets only (no Worker
// script, so requests are free and unlimited). Every unknown path serves
// index.html, so app routes like /survey/spots/<id> load on refresh.
{
  "name": "perch",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./apps/web/dist",
    "not_found_handling": "single-page-application"
  }
}
